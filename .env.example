# Template only. Copy names, never real values, into this file.
# Real values are set in Vercel: Project → Settings → Environment Variables.
#
# Supabase project URL (Supabase → Project Settings → API).
VITE_SUPABASE_URL=
# Supabase PUBLISHABLE (anon) key. Safe in the browser: database rules protect the data.
# NEVER put the secret / service_role key anywhere in this app.
VITE_SUPABASE_PUBLISHABLE_KEY=
